PORT=3002
LOG_LEVEL=info
# Must be the same secret the OS Service uses: staff tokens are validated here.
JWT_SECRET=change-me-in-production-use-a-long-random-string

# DynamoDB local from docker-compose.yml. On AWS these stay unset and the pod
# uses its own credentials.
AWS_ENDPOINT_URL=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

EXECUTIONS_TABLE=car-repair-shop-executions
EXECUTION_OUTBOX_TABLE=car-repair-shop-execution-outbox
PROCESSED_MESSAGES_TABLE=car-repair-shop-execution-processed-messages

# Without OTEL_EXPORTER_OTLP_ENDPOINT the tracing SDK stays off.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=execution-service
SERVICE_VERSION=0.0.0

CORS_ORIGIN=http://localhost:3002
TRUST_PROXY_HOPS=0
